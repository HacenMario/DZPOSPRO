# ================= DZ POS PRO v3 — Environment =================
# Core
MONGO_URI=mongodb://localhost:27017/dz_pos_pro
JWT_SECRET=change-me
JWT_EXPIRE=7d
PORT=3001
NODE_ENV=production
CORS_ORIGINS=https://dzpospro.vercel.app,https://your-backend.up.railway.app

# ---- v3: Google Gemini AI (FREE tier) ----
# Option A (recommended): paste the key from the dashboard → Settings → AI
# Option B: set it here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- v3: Weekly backup (cron syntax) ----
# Default: Sunday 03:00 — "0 3 * * 0"
BACKUP_CRON=0 3 * * 0
# Number of backup archives to keep (default 12)
BACKUP_KEEP=12
# Optional: POST each backup archive to this URL (off-site storage)
BACKUP_UPLOAD_URL=
# Optional: custom backups directory (persist it on Railway volumes)
BACKUP_DIR=

# ---- v3: Web Push (VAPID) ----
# Leave empty to auto-generate keys on first boot (stored in DB)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@dzpospro.com

# ---- v3: SaaS migration / seed ----
SEED_SUPERADMIN_EMAIL=super@dzpos.pro
SEED_SUPERADMIN_PASSWORD=
SEED_STORE_NAME=
